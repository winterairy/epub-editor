{
  "name": "epub-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first ebook editor",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "test:e2e": "playwright test",
    "package:win": "npm run build && electron-builder --win nsis",
    "postinstall": "node node_modules/electron/install.js"
  },
  "build": {
    "appId": "ai.winterairy.epubstudio",
    "productName": "EPUB Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d2coding": "1.3.2",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "mammoth": "1.13.0",
    "monaco-editor": "0.57.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xmlbuilder2": "4.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  }
}
